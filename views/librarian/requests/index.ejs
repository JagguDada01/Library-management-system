<%- include('../../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="bi bi-inbox text-warning me-2"></i>Manage Book Requests</h2>
    <p class="text-muted mb-0">Review, validate, approve, and reject book requests from members</p>
  </div>
</div>

<!-- Status Filter Tabs -->
<ul class="nav nav-pills mb-4">
  <li class="nav-item">
    <a class="nav-link <%= currentStatus === 'PENDING' ? 'active' : '' %>" href="/librarian/requests?status=PENDING">
      <i class="bi bi-hourglass-split me-1"></i> Pending Requests
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link <%= currentStatus === 'APPROVED' ? 'active' : '' %>" href="/librarian/requests?status=APPROVED">
      <i class="bi bi-check-circle me-1"></i> Approved
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link <%= currentStatus === 'REJECTED' ? 'active' : '' %>" href="/librarian/requests?status=REJECTED">
      <i class="bi bi-x-circle me-1"></i> Rejected
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link <%= currentStatus === 'all' ? 'active' : '' %>" href="/librarian/requests?status=all">
      <i class="bi bi-list-ul me-1"></i> All Requests
    </a>
  </li>
</ul>

<% if (requests && requests.length > 0) { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Member Name & Email</th>
              <th>Book Title & ISBN</th>
              <th>Current Stock</th>
              <th>Requested At</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% requests.forEach(function(req) { %>
              <tr>
                <td>
                  <div class="fw-bold"><%= req.member ? req.member.name : 'Unknown Member' %></div>
                  <div class="text-muted small"><%= req.member ? req.member.email : '' %></div>
                </td>
                <td>
                  <% if (req.book) { %>
                    <div class="fw-bold">
                      <a href="/books/<%= req.book._id %>" class="text-dark text-decoration-none">
                        <%= req.book.title %>
                      </a>
                    </div>
                    <div class="text-muted small">ISBN: <%= req.book.ISBN %></div>
                  <% } else { %>
                    <span class="text-muted fst-italic">Archived / Removed</span>
                  <% } %>
                </td>
                <td>
                  <% if (req.book) { %>
                    <span class="<%= req.book.availableCopies > 0 ? 'text-success fw-bold' : 'text-danger fw-bold' %>">
                      <%= req.book.availableCopies %> / <%= req.book.totalCopies %>
                    </span>
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td><%= new Date(req.requestedAt).toLocaleString() %></td>
                <td>
                  <% if (req.status === 'PENDING') { %>
                    <span class="badge badge-pending px-3 py-1">PENDING</span>
                  <% } else if (req.status === 'APPROVED') { %>
                    <span class="badge badge-approved px-3 py-1">APPROVED</span>
                  <% } else { %>
                    <span class="badge badge-rejected px-3 py-1">REJECTED</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <% if (req.status === 'PENDING') { %>
                    <div class="d-flex justify-content-end gap-2">
                      <!-- Approve Form -->
                      <form action="/librarian/requests/<%= req._id %>/approve" method="POST" data-confirm="Approve request and issue book '<%= req.book ? req.book.title : 'Book' %>' to '<%= req.member ? req.member.name : 'Member' %>'?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-sm btn-success" <%= (!req.book || req.book.availableCopies <= 0) ? 'disabled title="No copies available"' : '' %>>
                          <i class="bi bi-check-lg me-1"></i> Approve & Issue
                        </button>
                      </form>

                      <!-- Reject Button triggering Modal -->
                      <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal<%= req._id %>">
                        <i class="bi bi-x-lg me-1"></i> Reject
                      </button>
                    </div>

                    <!-- Reject Modal -->
                    <div class="modal fade" id="rejectModal<%= req._id %>" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog text-start">
                        <div class="modal-content">
                          <form action="/librarian/requests/<%= req._id %>/reject" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="modal-header">
                              <h5 class="modal-title fw-bold">Reject Book Request</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                              <p class="text-muted small mb-3">
                                Reject request from <strong><%= req.member ? req.member.name : 'Member' %></strong> for <em><%= req.book ? req.book.title : 'Book' %></em>.
                              </p>
                              <div class="mb-3">
                                <label for="rejectionReason<%= req._id %>" class="form-label fw-semibold">Reason for Rejection</label>
                                <textarea class="form-control" id="rejectionReason<%= req._id %>" name="rejectionReason" rows="3" placeholder="e.g., Book is reserved for in-library reference or copies are undergoing repairs..." required></textarea>
                              </div>
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                              <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  <% } else if (req.status === 'REJECTED') { %>
                    <span class="small text-muted" title="<%= req.rejectionReason %>">
                      Reason: <%= req.rejectionReason || 'None given' %>
                    </span>
                  <% } else { %>
                    <span class="small text-success">
                      <i class="bi bi-check-circle me-1"></i>Issued
                    </span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%- include('../../partials/pagination') %>

<% } else { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body empty-state">
      <i class="bi bi-inbox"></i>
      <h4 class="fw-bold">No Requests Found</h4>
      <p class="text-muted">There are no <%= currentStatus !== 'all' ? currentStatus.toLowerCase() : '' %> book requests to display.</p>
    </div>
  </div>
<% } %>

<%- include('../../partials/footer') %>
