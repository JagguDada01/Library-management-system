<%- include('../../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="bi bi-collection text-primary me-2"></i>Book Inventory Management</h2>
    <p class="text-muted mb-0">View, update, monitor physical copies, and archive titles</p>
  </div>
  <a href="/librarian/books/new" class="btn btn-success">
    <i class="bi bi-plus-circle me-1"></i> Add New Book
  </a>
</div>

<!-- Search & Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3">
    <form action="/librarian/books" method="GET" class="row g-2 align-items-center">
      <div class="col-md-4">
        <input
          type="text"
          class="form-control"
          name="search"
          value="<%= query.search || '' %>"
          placeholder="Search by title, author, or ISBN..."
        >
      </div>

      <div class="col-md-3">
        <select class="form-select" name="category">
          <option value="all" <%= query.category === 'all' ? 'selected' : '' %>>All Categories</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-3">
        <select class="form-select" name="status">
          <option value="all" <%= query.status === 'all' ? 'selected' : '' %>>All Statuses (Active & Archived)</option>
          <option value="active" <%= query.status === 'active' ? 'selected' : '' %>>Active Only</option>
          <option value="archived" <%= query.status === 'archived' ? 'selected' : '' %>>Archived Only</option>
        </select>
      </div>

      <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary w-100">
          <i class="bi bi-funnel"></i> Filter
        </button>
        <a href="/librarian/books" class="btn btn-outline-secondary" title="Reset">
          <i class="bi bi-arrow-counterclockwise"></i>
        </a>
      </div>
    </form>
  </div>
</div>

<!-- Inventory Table -->
<% if (books && books.length > 0) { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Title & Author</th>
              <th>Category</th>
              <th>ISBN</th>
              <th>Total</th>
              <th>Available</th>
              <th>Issued</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% books.forEach(function(book) { %>
              <% const issued = book.totalCopies - book.availableCopies; %>
              <tr>
                <td>
                  <div class="fw-bold">
                    <a href="/books/<%= book._id %>" class="text-dark text-decoration-none">
                      <%= book.title %>
                    </a>
                  </div>
                  <div class="text-muted small"><%= book.author %></div>
                </td>
                <td><span class="badge bg-light text-dark border"><%= book.categoryName || (typeof book.category === 'object' && book.category ? book.category.name : (book.category || 'General')) %></span></td>
                <td><code><%= book.ISBN || book.isbn %></code></td>
                <td><span class="fw-semibold"><%= book.totalCopies %></span></td>
                <td>
                  <span class="<%= book.availableCopies > 0 ? 'text-success fw-bold' : 'text-danger fw-bold' %>">
                    <%= book.availableCopies %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-light text-dark border"><%= issued %></span>
                </td>
                <td>
                  <% if (book.isActive) { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                  <% } else { %>
                    <span class="badge bg-secondary">Archived</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <div class="btn-group btn-group-sm">
                    <a href="/librarian/books/<%= book._id %>/edit" class="btn btn-outline-primary" title="Edit book details">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <% if (book.isActive) { %>
                      <form action="/librarian/books/<%= book._id %>/archive" method="POST" class="d-inline" data-confirm="Archive book '<%= book.title %>'? Archived books cannot be requested by members, but historical loans remain intact.">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline-warning" title="Archive book">
                          <i class="bi bi-archive"></i>
                        </button>
                      </form>
                    <% } else { %>
                      <form action="/librarian/books/<%= book._id %>/restore" method="POST" class="d-inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline-success" title="Restore book to catalog">
                          <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%- include('../../partials/pagination') %>

<% } else { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body empty-state">
      <i class="bi bi-journal-album"></i>
      <h4 class="fw-bold">No Books Found in Inventory</h4>
      <p class="text-muted">No books matched your criteria. Add a new book to expand the library.</p>
      <a href="/librarian/books/new" class="btn btn-success px-4">
        <i class="bi bi-plus-circle me-1"></i> Add First Book
      </a>
    </div>
  </div>
<% } %>

<%- include('../../partials/footer') %>
