<%- include('../../partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <div>
        <h3 class="fw-bold mb-0"><i class="bi bi-person-plus text-primary me-2"></i>Direct Issue Book</h3>
        <p class="text-muted small mb-0">Issue a physical copy directly to a registered library member</p>
      </div>
      <a href="/librarian/loans" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Loans
      </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-body p-4 p-md-5">
        <form action="/librarian/loans/issue" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <!-- Select Member -->
          <div class="mb-4">
            <label for="memberId" class="form-label fw-semibold">Select Member <span class="text-danger">*</span></label>
            <select class="form-select" id="memberId" name="memberId" required>
              <option value="" disabled selected>Choose a registered member...</option>
              <% members.forEach(function(member) { %>
                <option value="<%= member._id %>">
                  <%= member.name %> &mdash; <%= member.email %>
                </option>
              <% }); %>
            </select>
            <div class="form-text small">Members cannot exceed the maximum active loan limit of 5 books.</div>
          </div>

          <!-- Select Book -->
          <div class="mb-4">
            <label for="bookId" class="form-label fw-semibold">Select Book to Issue <span class="text-danger">*</span></label>
            <select class="form-select" id="bookId" name="bookId" required>
              <option value="" disabled selected>Choose an in-stock book...</option>
              <% books.forEach(function(book) { %>
                <option value="<%= book._id %>">
                  <%= book.title %> (Available: <%= book.availableCopies %> / <%= book.totalCopies %>) &mdash; <%= book.category %>
                </option>
              <% }); %>
            </select>
            <div class="form-text small">Only books with available copies (> 0) are listed.</div>
          </div>

          <!-- Lending Policy Summary Box -->
          <div class="card bg-light border-0 mb-4">
            <div class="card-body p-3 small text-muted">
              <div class="fw-bold text-dark mb-1"><i class="bi bi-clock-history text-primary me-1"></i> Default Lending Terms:</div>
              <ul class="mb-0 ps-3">
                <li>Loan duration: <strong>14 calendar days</strong> (automatically calculated)</li>
                <li>Overdue fee rate: <strong>$5.00 per calendar day</strong></li>
                <li>Single copy rule: A member cannot borrow two copies of the same title concurrently</li>
              </ul>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2">
            <a href="/librarian/loans" class="btn btn-outline-secondary px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold">
              <i class="bi bi-check2-circle me-1"></i> Complete Loan Issue
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
