<%- include('../../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="bi bi-arrow-left-right text-primary me-2"></i>Loans & Returns Management</h2>
    <p class="text-muted mb-0">Track circulating loans, process book returns, and assess overdue fines</p>
  </div>
  <a href="/librarian/loans/issue" class="btn btn-primary">
    <i class="bi bi-plus-lg me-1"></i> Direct Issue Book
  </a>
</div>

<!-- Status Filters -->
<ul class="nav nav-pills mb-4">
  <li class="nav-item">
    <a class="nav-link <%= currentStatus === 'all' ? 'active' : '' %>" href="/librarian/loans?status=all">
      All Loans
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link <%= currentStatus === 'ISSUED' ? 'active' : '' %>" href="/librarian/loans?status=ISSUED">
      Active Loans
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link <%= currentStatus === 'OVERDUE' ? 'active' : '' %>" href="/librarian/loans?status=OVERDUE">
      <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i> Overdue Only
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link <%= currentStatus === 'RETURNED' ? 'active' : '' %>" href="/librarian/loans?status=RETURNED">
      Returned History
    </a>
  </li>
</ul>

<% if (loans && loans.length > 0) { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Member</th>
              <th>Book Title & Details</th>
              <th>Issued Date</th>
              <th>Due Date</th>
              <th>Status</th>
              <th>Fine</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% loans.forEach(function(loan) { %>
              <tr>
                <td>
                  <div class="fw-bold"><%= loan.member ? loan.member.name : 'Unknown Member' %></div>
                  <div class="text-muted small"><%= loan.member ? loan.member.email : '' %></div>
                </td>
                <td>
                  <% if (loan.book) { %>
                    <div class="fw-bold">
                      <a href="/books/<%= loan.book._id %>" class="text-dark text-decoration-none">
                        <%= loan.book.title %>
                      </a>
                    </div>
                    <div class="text-muted small">ISBN: <%= loan.book.ISBN %></div>
                  <% } else { %>
                    <span class="text-muted fst-italic">Archived title</span>
                  <% } %>
                </td>
                <td><%= new Date(loan.issuedAt).toLocaleDateString() %></td>
                <td>
                  <div class="<%= loan.isOverdue && loan.status === 'ISSUED' ? 'text-danger fw-bold' : '' %>">
                    <%= new Date(loan.dueDate).toLocaleDateString() %>
                  </div>
                  <% if (loan.isOverdue && loan.status === 'ISSUED') { %>
                    <small class="text-danger"><%= loan.overdueDays %> day(s) late</small>
                  <% } %>
                </td>
                <td>
                  <% if (loan.status === 'RETURNED') { %>
                    <span class="badge badge-returned px-3 py-1">RETURNED</span>
                  <% } else if (loan.isOverdue) { %>
                    <span class="badge badge-overdue px-3 py-1">OVERDUE</span>
                  <% } else { %>
                    <span class="badge badge-issued px-3 py-1">ISSUED</span>
                  <% } %>
                </td>
                <td>
                  <% if (loan.calculatedFine > 0) { %>
                    <span class="text-danger fw-bold">$<%= loan.calculatedFine.toFixed(2) %></span>
                    <% if (loan.status === 'ISSUED') { %>
                      <div class="text-muted small">(accruing)</div>
                    <% } %>
                  <% } else { %>
                    <span class="text-muted">$0.00</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <% if (loan.status === 'ISSUED') { %>
                    <form action="/librarian/loans/<%= loan._id %>/return" method="POST" data-confirm="Confirm return of '<%= loan.book ? loan.book.title : 'Book' %>'? Available copies will be safely incremented. <%= loan.calculatedFine > 0 ? 'A fine of $' + loan.calculatedFine.toFixed(2) + ' will be recorded.' : '' %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-box-arrow-in-left me-1"></i> Process Return
                      </button>
                    </form>
                  <% } else { %>
                    <span class="small text-muted">
                      Returned <%= loan.returnedAt ? new Date(loan.returnedAt).toLocaleDateString() : '' %>
                    </span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%- include('../../partials/pagination') %>

<% } else { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body empty-state">
      <i class="bi bi-journal-check"></i>
      <h4 class="fw-bold">No Loans Found</h4>
      <p class="text-muted">No loan records matched the selected status filter.</p>
    </div>
  </div>
<% } %>

<%- include('../../partials/footer') %>
