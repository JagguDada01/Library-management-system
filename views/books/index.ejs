<%- include('../partials/header') %>

<div class="row mb-4 align-items-center">
  <div class="col-md-7">
    <h2 class="fw-bold mb-1"><i class="bi bi-compass text-primary me-2"></i>Library Catalog</h2>
    <p class="text-muted mb-0">Search, discover, and request books from our collection</p>
  </div>
  <div class="col-md-5 text-md-end mt-3 mt-md-0">
    <% if (currentUser && currentUser.role === 'LIBRARIAN') { %>
      <a href="/librarian/books/new" class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i> Add New Book
      </a>
      <a href="/librarian/books" class="btn btn-outline-secondary ms-1">
        <i class="bi bi-gear me-1"></i> Manage Inventory
      </a>
    <% } else if (currentUser && currentUser.role === 'MEMBER') { %>
      <a href="/member/loans" class="btn btn-outline-primary">
        <i class="bi bi-journal-bookmark me-1"></i> My Borrowed Books
      </a>
    <% } %>
  </div>
</div>

<!-- Search & Filter Controls -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3 p-md-4">
    <form action="/books" method="GET" class="row g-3 align-items-end">
      <!-- Search Input -->
      <div class="col-lg-5 col-md-6">
        <label for="search" class="form-label small fw-bold text-muted text-uppercase">Search</label>
        <div class="input-group">
          <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
          <input
            type="text"
            class="form-control"
            id="search"
            name="search"
            value="<%= query.search || '' %>"
            placeholder="Search by title, author, or ISBN..."
          >
        </div>
      </div>

      <!-- Category Filter -->
      <div class="col-lg-3 col-md-3">
        <label for="category" class="form-label small fw-bold text-muted text-uppercase">Category</label>
        <select class="form-select" id="category" name="category">
          <option value="all" <%= query.category === 'all' ? 'selected' : '' %>>All Categories</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }); %>
        </select>
      </div>

      <!-- Availability Filter -->
      <div class="col-lg-2 col-md-3">
        <label for="availability" class="form-label small fw-bold text-muted text-uppercase">Availability</label>
        <select class="form-select" id="availability" name="availability">
          <option value="all" <%= query.availability === 'all' ? 'selected' : '' %>>All</option>
          <option value="available" <%= query.availability === 'available' ? 'selected' : '' %>>Available Now</option>
          <option value="unavailable" <%= query.availability === 'unavailable' ? 'selected' : '' %>>Out of Stock</option>
        </select>
      </div>

      <!-- Action Buttons -->
      <div class="col-lg-2 col-md-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary w-100 fw-semibold">
          <i class="bi bi-funnel me-1"></i> Filter
        </button>
        <% if (query.search || (query.category && query.category !== 'all') || (query.availability && query.availability !== 'all')) { %>
          <a href="/books" class="btn btn-outline-secondary" title="Reset filters">
            <i class="bi bi-arrow-counterclockwise"></i>
          </a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<!-- Books Catalog Grid -->
<% if (books && books.length > 0) { %>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% books.forEach(function(book) { %>
      <div class="col">
        <div class="card h-100 card-hover border-0 shadow-sm overflow-hidden">
          <!-- Book Cover Graphic -->
          <div class="book-cover-art">
            <i class="bi bi-journal-richtext display-6 mb-1 text-warning"></i>
            <span class="badge bg-light text-dark fw-semibold small"><%= book.categoryName || (typeof book.category === 'object' && book.category ? book.category.name : book.category) %></span>
          </div>

          <div class="card-body d-flex flex-direction-column flex-column p-3">
            <div class="mb-2">
              <h5 class="card-title fw-bold mb-1 text-truncate" title="<%= book.title %>">
                <a href="/books/<%= book._id %>" class="text-dark text-decoration-none">
                  <%= book.title %>
                </a>
              </h5>
              <div class="text-muted small">
                <i class="bi bi-person me-1"></i> <%= book.author %>
              </div>
            </div>

            <div class="small text-muted mb-3">
              <span class="badge bg-light text-secondary border">ISBN: <%= book.ISBN || book.isbn %></span>
            </div>

            <p class="card-text text-secondary small flex-grow-1 mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
              <%= book.description || 'No description provided.' %>
            </p>

            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
              <div>
                <% if (book.availableCopies > 0) { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="bi bi-check-circle me-1"></i> <%= book.availableCopies %> / <%= book.totalCopies %> Available
                  </span>
                <% } else { %>
                  <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                    <i class="bi bi-x-circle me-1"></i> All Copies Issued
                  </span>
                <% } %>
              </div>
              <a href="/books/<%= book._id %>" class="btn btn-sm btn-outline-primary">
                View <i class="bi bi-arrow-right ms-1"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

  <%- include('../partials/pagination') %>

<% } else { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body empty-state">
      <i class="bi bi-book"></i>
      <h4 class="fw-bold">No Books Found</h4>
      <p class="text-muted">No books matched your search or filter criteria. Try adjusting your search query.</p>
      <a href="/books" class="btn btn-outline-primary px-4">
        <i class="bi bi-arrow-clockwise me-1"></i> Clear Filters
      </a>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
