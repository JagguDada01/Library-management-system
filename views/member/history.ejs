<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="bi bi-archive text-primary me-2"></i>Borrowing History</h2>
    <p class="text-muted mb-0">Complete record of books you have borrowed and returned</p>
  </div>
  <a href="/member/loans" class="btn btn-outline-primary">
    <i class="bi bi-journal-bookmark me-1"></i> Active Loans
  </a>
</div>

<% if (loans && loans.length > 0) { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Book Title & Details</th>
              <th>Borrowed On</th>
              <th>Due Date</th>
              <th>Returned On</th>
              <th>Status</th>
              <th>Final Fine</th>
            </tr>
          </thead>
          <tbody>
            <% loans.forEach(function(loan) { %>
              <tr>
                <td>
                  <div class="fw-bold">
                    <a href="/books/<%= loan.book ? loan.book._id : '' %>" class="text-dark text-decoration-none">
                      <%= loan.book ? loan.book.title : 'Archived Title' %>
                    </a>
                  </div>
                  <div class="text-muted small">
                    <%= loan.book ? 'by ' + loan.book.author + ' (ISBN: ' + loan.book.ISBN + ')' : '' %>
                  </div>
                </td>
                <td><%= new Date(loan.issuedAt).toLocaleDateString() %></td>
                <td><%= new Date(loan.dueDate).toLocaleDateString() %></td>
                <td>
                  <% if (loan.returnedAt) { %>
                    <span class="text-success"><%= new Date(loan.returnedAt).toLocaleDateString() %></span>
                  <% } else { %>
                    <span class="text-muted">Not returned yet</span>
                  <% } %>
                </td>
                <td>
                  <% if (loan.status === 'RETURNED') { %>
                    <span class="badge badge-returned px-3 py-1">
                      <i class="bi bi-check-all me-1"></i> RETURNED
                    </span>
                  <% } else { %>
                    <span class="badge badge-issued px-3 py-1">
                      <i class="bi bi-hourglass-split me-1"></i> ISSUED
                    </span>
                  <% } %>
                </td>
                <td>
                  <% if (loan.fine > 0) { %>
                    <span class="badge bg-danger text-white px-2 py-1">$<%= loan.fine.toFixed(2) %></span>
                  <% } else { %>
                    <span class="text-muted">$0.00</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%- include('../partials/pagination') %>

<% } else { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body empty-state">
      <i class="bi bi-clock-history"></i>
      <h4 class="fw-bold">No Borrowing History</h4>
      <p class="text-muted">You have not returned any books yet. Once you borrow and return books, they will appear here.</p>
      <a href="/books" class="btn btn-primary px-4">
        <i class="bi bi-compass me-1"></i> Explore Books
      </a>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
