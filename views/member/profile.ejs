<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
      <div class="card-body p-4 p-md-5">
        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
          <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; font-size: 1.8rem; font-weight: 700;">
            <%= user.name.charAt(0).toUpperCase() %>
          </div>
          <div>
            <h3 class="fw-bold mb-0"><%= user.name %></h3>
            <span class="badge <%= user.role === 'LIBRARIAN' ? 'bg-danger' : 'bg-primary' %> px-3 py-1">
              <i class="bi <%= user.role === 'LIBRARIAN' ? 'bi-shield-check' : 'bi-person' %> me-1"></i>
              <%= user.role %>
            </span>
          </div>
        </div>

        <div class="row g-3">
          <div class="col-sm-6">
            <label class="form-label text-muted small text-uppercase fw-semibold">Email Address</label>
            <div class="fs-6 fw-semibold text-dark"><%= user.email %></div>
          </div>
          <div class="col-sm-6">
            <label class="form-label text-muted small text-uppercase fw-semibold">Member Since</label>
            <div class="fs-6 fw-semibold text-dark"><%= new Date(user.createdAt).toLocaleDateString() %></div>
          </div>
        </div>

        <div class="card bg-light border-0 mt-4">
          <div class="card-body p-3 small text-muted">
            <i class="bi bi-shield-lock text-primary me-1"></i>
            <strong>Security Notice:</strong> Account privileges and role memberships are managed strictly by system administrators. Normal members cannot alter their assigned security clearance.
          </div>
        </div>

        <div class="mt-4 pt-3 border-top d-flex gap-2">
          <% if (user.role === 'LIBRARIAN') { %>
            <a href="/librarian/dashboard" class="btn btn-primary"><i class="bi bi-speedometer2 me-1"></i> Go to Admin Dashboard</a>
          <% } else { %>
            <a href="/member/dashboard" class="btn btn-primary"><i class="bi bi-speedometer2 me-1"></i> Go to Member Dashboard</a>
            <a href="/member/loans" class="btn btn-outline-secondary"><i class="bi bi-journal-bookmark me-1"></i> My Loans</a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
