<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="bi bi-journal-bookmark text-primary me-2"></i>My Borrowed Books</h2>
    <p class="text-muted mb-0">Track your active book loans, due dates, and accrued fines</p>
  </div>
  <a href="/books" class="btn btn-outline-primary">
    <i class="bi bi-plus-lg me-1"></i> Borrow More
  </a>
</div>

<% if (loans && loans.length > 0) { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Book Title & Details</th>
              <th>Category</th>
              <th>Date Issued</th>
              <th>Due Date</th>
              <th>Status</th>
              <th>Accrued Fine</th>
            </tr>
          </thead>
          <tbody>
            <% loans.forEach(function(loan) { %>
              <tr>
                <td>
                  <div class="fw-bold fs-6">
                    <a href="/books/<%= loan.book._id %>" class="text-dark text-decoration-none">
                      <%= loan.book.title %>
                    </a>
                  </div>
                  <div class="text-muted small">
                    by <%= loan.book.author %> &bull; ISBN: <%= loan.book.ISBN %>
                  </div>
                </td>
                <td>
                  <span class="badge bg-light text-dark border"><%= loan.book.category %></span>
                </td>
                <td><%= new Date(loan.issuedAt).toLocaleDateString() %></td>
                <td>
                  <div class="<%= loan.isOverdue ? 'text-danger fw-bold' : '' %>">
                    <%= new Date(loan.dueDate).toLocaleDateString() %>
                  </div>
                  <% if (loan.isOverdue) { %>
                    <small class="text-danger"><%= loan.overdueDays %> day(s) late</small>
                  <% } %>
                </td>
                <td>
                  <% if (loan.isOverdue) { %>
                    <span class="badge badge-overdue px-3 py-1">
                      <i class="bi bi-exclamation-triangle-fill me-1"></i> OVERDUE
                    </span>
                  <% } else { %>
                    <span class="badge badge-issued px-3 py-1">
                      <i class="bi bi-bookmark-check me-1"></i> ISSUED
                    </span>
                  <% } %>
                </td>
                <td>
                  <% if (loan.currentFine > 0) { %>
                    <span class="text-danger fw-bold fs-6">$<%= loan.currentFine.toFixed(2) %></span>
                    <div class="text-muted small">($5/day fine)</div>
                  <% } else { %>
                    <span class="text-success fw-semibold">$0.00</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card mt-4 bg-light border-0 shadow-sm">
    <div class="card-body p-3 small text-muted">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-info-circle text-primary fs-5"></i>
        <span><strong>Library Returning Policy:</strong> Books must be returned to the library circulation desk. Fines are calculated automatically at $5.00 per day for every day past the due date.</span>
      </div>
    </div>
  </div>

<% } else { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body empty-state">
      <i class="bi bi-journal-x"></i>
      <h4 class="fw-bold">No Active Loans</h4>
      <p class="text-muted">You currently do not have any borrowed books in your possession.</p>
      <a href="/books" class="btn btn-primary px-4">
        <i class="bi bi-compass me-1"></i> Explore Book Catalog
      </a>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
