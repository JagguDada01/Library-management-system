<%- include('../partials/header') %>

<div class="row justify-content-center my-5 py-5">
  <div class="col-md-7 text-center">
    <div class="display-1 text-primary fw-bold mb-3">404</div>
    <h2 class="fw-bold mb-3">Page or Book Not Found</h2>
    <p class="text-muted lead mb-4">
      <%= typeof message !== 'undefined' && message ? message : 'The book, resource, or page you were looking for does not exist or has been removed.' %>
    </p>
    <div class="d-flex justify-content-center gap-2">
      <a href="/books" class="btn btn-primary px-4"><i class="bi bi-compass me-1"></i> Browse Catalog</a>
      <a href="/" class="btn btn-outline-secondary px-4"><i class="bi bi-house me-1"></i> Home</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
