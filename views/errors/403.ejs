<%- include('../partials/header') %>

<div class="row justify-content-center my-5 py-5">
  <div class="col-md-7 text-center">
    <div class="display-1 text-danger fw-bold mb-3">403</div>
    <h2 class="fw-bold mb-3">Access Forbidden</h2>
    <p class="text-muted lead mb-4">
      <%= typeof message !== 'undefined' && message ? message : 'You do not have permission to perform this action or view this protected page.' %>
    </p>
    <div class="d-flex justify-content-center gap-2">
      <% if (currentUser && currentUser.role === 'LIBRARIAN') { %>
        <a href="/librarian/dashboard" class="btn btn-primary px-4"><i class="bi bi-speedometer2 me-1"></i> Librarian Dashboard</a>
      <% } else if (currentUser) { %>
        <a href="/member/dashboard" class="btn btn-primary px-4"><i class="bi bi-speedometer2 me-1"></i> Member Dashboard</a>
      <% } else { %>
        <a href="/login" class="btn btn-primary px-4"><i class="bi bi-box-arrow-in-right me-1"></i> Log In</a>
      <% } %>
      <a href="/" class="btn btn-outline-secondary px-4"><i class="bi bi-house me-1"></i> Library Catalog</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
