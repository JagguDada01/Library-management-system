<%- include('../partials/header') %>

<div class="row justify-content-center my-5 py-5">
  <div class="col-md-7 text-center">
    <div class="display-1 text-warning fw-bold mb-3">400</div>
    <h2 class="fw-bold mb-3">Bad Request</h2>
    <p class="text-muted lead mb-4">
      <%= typeof message !== 'undefined' && message ? message : 'The request could not be understood or was missing required parameters.' %>
    </p>
    <div class="d-flex justify-content-center gap-2">
      <a href="/" class="btn btn-primary px-4"><i class="bi bi-house me-1"></i> Return Home</a>
      <a href="javascript:history.back()" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-1"></i> Go Back</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
